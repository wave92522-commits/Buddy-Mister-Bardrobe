		{ "ЛКМ 2 · Бэкхенд", "Backhand" }, { "ПКМ 2 · Вихрь", "Vortex" },
		{ "ЛКМ 3 · Сверху", "Overhead" }, { "Достать", "Draw" },
		{ "Осмотр (F)", "Inspect" }, { "Фиджет", "Fidget" },
	}) do
		button(test[1], false, function()
			if state.Equipped then
				startAction(ANIMS[test[2]], state.Action ~= nil)
			end
		end, grid)
	end

	track(UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if activeSlider then
			activeSlider.FromX(input.Position.X)
		elseif dragStart then
			local d = input.Position - dragStart
			panel.Position = UDim2.new(panelStart.X.Scale, panelStart.X.Offset + d.X, panelStart.Y.Scale, panelStart.Y.Offset + d.Y)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider, dragStart = nil, nil
		end
	end))

	local prevIcon = nil
	local function setOpen(open)
		panel.Visible = open
		if open then
			prevIcon = UserInputService.MouseIconEnabled
			refreshAll()
		elseif prevIcon ~= nil then
			UserInputService.MouseIconEnabled = prevIcon
		end
	end
	track(toggle.Activated:Connect(function()
		setOpen(not panel.Visible)
	end))
	track(close.Activated:Connect(function()
		setOpen(false)
	end))
	track(UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == CONFIG.PoseGUIKey then
			setOpen(not panel.Visible)
		end
	end))
end

