local FACTORY_POSE = deepCopy(CONFIG.Pose)
local LMB_ANIMS, RMB_ANIMS = {}, {}

local function sanitizePose()
	local pose = CONFIG.Pose
	for key, value in pairs(FACTORY_POSE) do
		if type(value) == "table" then
			pose[key] = type(pose[key]) == "table" and pose[key] or {}
			for k, v in pairs(value) do
				if type(pose[key][k]) ~= "number" then
					pose[key][k] = v
				end
			end
		elseif type(pose[key]) ~= "number" then
			pose[key] = value
		end
	end
end

local function applyPoseConfig()
	sanitizePose()
	local h, k = CONFIG.Pose.Hand, CONFIG.Pose.Knife
	HOLD = CFrame.new(h.X, h.Y, h.Z) * ANG(h.Pitch, h.Yaw, h.Roll) * BASE_HOLD_ROT
