local Gui = {}

local function fmtNum(v)
	local s = string.format("%.3f", v)
	s = s:gsub("0+$", ""):gsub("%.$", "")
	if s == "-0" then
		s = "0"
	end
	return s
end

local function exportPose()
	local p = CONFIG.Pose
	local function six(t)
		return string.format("{ X = %s, Y = %s, Z = %s, Pitch = %s, Yaw = %s, Roll = %s }",
			fmtNum(t.X), fmtNum(t.Y), fmtNum(t.Z), fmtNum(t.Pitch), fmtNum(t.Yaw), fmtNum(t.Roll))
	end
	return table.concat({
		"Pose = {",
		"\tHand = " .. six(p.Hand) .. ",",
		"\tKnife = " .. six(p.Knife) .. ",",
		string.format("\tCameraFollow = %s, Sway = %s, WalkBob = %s, Breathing = %s,",
			fmtNum(p.CameraFollow), fmtNum(p.Sway), fmtNum(p.WalkBob), fmtNum(p.Breathing)),
		"},",
	}, "\n")
end

local function importPose(text)
	local newPose = deepCopy(CONFIG.Pose)
	local found = false
	for _, section in ipairs({ "Hand", "Knife" }) do
		local body = string.match(text, section .. "%s*=%s*(%b{})")
		if body then
			for k, v in string.gmatch(body, "(%a+)%s*=%s*(%-?[%d%.]+)") do
				if newPose[section][k] ~= nil and tonumber(v) then
					newPose[section][k] = tonumber(v)
					found = true
				end
			end
		end
	end
	for _, key in ipairs({ "CameraFollow", "Sway", "WalkBob", "Breathing" }) do
		local v = string.match(text, key .. "%s*=%s*(%-?[%d%.]+)")
		if v and tonumber(v) then
			newPose[key] = tonumber(v)
			found = true
		end
	end
	if found then
		CONFIG.Pose = newPose
		applyPoseConfig()
	end
	return found
end

