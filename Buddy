------------------------------------------------------------------------
local function updateKnife(knife, pose)
	local d = PIN_D * S
	knife.BladeMotor.C0 = CFrame.Angles(0, 0, rad(pose.A)) * CFrame.new(d, 0, 0)
	knife.BiteMotor.C0 = CFrame.new(d, 0, 0) * CFrame.Angles(0, 0, rad(pose.C))
	knife.LatchMotor.C0 = CFrame.new(0, LATCH_Y * S, 0) * CFrame.Angles(0, 0, -rad(90 * math.clamp(pose.Latch, 0, 1)))

	local shine = pose.Shine
	for _, g in ipairs(knife.Glints) do
		if shine > 0.02 and shine < 0.98 then
			g.Weld.C0 = CFrame.new(0, (0.1 + 0.6 * shine) * S, 0) * ANG(0, 0, 25)
			g.Part.Transparency = 1 - math.sin(PI * shine) * 0.85
		elseif g.Part.Transparency < 1 then
			g.Part.Transparency = 1
		end
	end
	knife.Trail.Enabled = CONFIG.Trail and pose.Trail > 0.5

	-- разлом «дышит»: неон мерцает волной вдоль клинка
	local t = state.Clock
	for i, part in ipairs(knife.Glow) do
		part.Transparency = 0.12 + 0.12 * math.sin(t * 3.2 - i * 0.7)
	end
	if knife.Light then
		knife.Light.Brightness = 0.55 + 0.2 * math.sin(t * 3.2) + (pose.Trail > 0.5 and 0.5 or 0)
	end
end

------------------------------------------------------------------------
-- ГЛАВНЫЙ ЦИКЛ
------------------------------------------------------------------------
local function step(dt)
	if dt <= 0 then
		return
	end
	dt = math.min(dt, 1 / 20)
	local rig = state.Rig
	if not rig or not rig.Torso.Parent or rig.Humanoid.Health <= 0 then
		return
	end
	local cfg = CONFIG.Pose
	state.Clock = state.Clock + dt

	if state.Equipped then
		state.Weight = math.min(1, state.Weight + dt / CONFIG.EquipTime)
	else
		state.Weight = math.max(0, state.Weight - dt / CONFIG.UnequipTime)
	end
	if state.Weight <= 0 then
		state.LastRX = nil
		return
	end

	-- инерция от поворота камеры
	local cam = Workspace.CurrentCamera
	local camCF = cam and cam.CFrame or rig.Torso.CFrame
	local rx, ry = camCF:ToOrientation()
	if state.LastRX then
		local dYaw = (ry - state.LastRY + PI) % (2 * PI) - PI
		local dPitch = rx - state.LastRX
		local k = 0.04 * cfg.Sway
		local target = Vector2.new(math.clamp(dYaw / dt * k, -0.3, 0.3), math.clamp(dPitch / dt * k, -0.25, 0.25))
		local acc = (target - state.Sway) * 160 - state.SwayVel * 18
		state.SwayVel = state.SwayVel + acc * dt
		state.Sway = state.Sway + state.SwayVel * dt
	end
	state.LastRX, state.LastRY = rx, ry

	-- нож следует за наклоном камеры, вращаясь вокруг глаз
	local torsoCF = rig.Torso.CFrame
	local lookLocal = torsoCF:VectorToObjectSpace(camCF.LookVector)
	local pitch = math.asin(math.clamp(lookLocal.Y, -1, 1))
	local firstPerson = rig.Head and (camCF.Position - rig.Head.Position).Magnitude < 2.5
	local eyeY = 1.5
	if firstPerson then
		eyeY = torsoCF:PointToObjectSpace(camCF.Position).Y
	elseif rig.Head then
		eyeY = torsoCF:PointToObjectSpace(rig.Head.Position).Y
	end
	state.PivotY = state.PivotY + (math.clamp(eyeY, 0.6, 2.4) - state.PivotY) * damp(10, dt)
	local factor = cfg.CameraFollow * (firstPerson and 1 or 0.6)
	state.Pitch = state.Pitch + (math.clamp(pitch, -1.1, 1.1) * factor - state.Pitch) * damp(14, dt)
	local pivot = CFrame.new(0, state.PivotY, 0)
	local pitchCF = pivot * CFrame.Angles(state.Pitch, 0, 0) * pivot:Inverse()

	-- покачивание при ходьбе
	local vel = rig.RootPart.AssemblyLinearVelocity
	local planar = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local moving = planar > 1.5 and rig.Humanoid.FloorMaterial ~= Enum.Material.Air
	local bobTarget = moving and math.clamp(planar / 16, 0, 1.3) * cfg.WalkBob or 0
	state.BobAmount = state.BobAmount + (bobTarget - state.BobAmount) * damp(8, dt)
	state.BobPhase = state.BobPhase + dt * (4 + planar * 0.55)
	local ph = state.BobPhase
	local bob = V(math.sin(ph) * 0.03, -math.abs(math.cos(ph)) * 0.04, 0) * state.BobAmount

	-- фиджет в покое
	if CONFIG.IdleFidget and state.Equipped and not state.Action and state.Weight >= 1 then
		state.FidgetTimer = state.FidgetTimer - dt
		if state.FidgetTimer <= 0 then
			if state.BobAmount < 0.15 then
				startAction(ANIMS.Fidget, false)
			else
				state.FidgetTimer = 3
			end
		end
	end

	-- текущая поза
	local action = state.Action
	if action then
		action.Time = action.Time + dt
		local events = action.Anim.Events
		while events[action.NextEvent] and action.Time >= events[action.NextEvent][1] do
			playEvent(events[action.NextEvent][2])
			action.NextEvent = action.NextEvent + 1
		end
		if action.Time >= action.Anim.Length then
			state.Action = nil
			action = nil
		end
	end
	local pose = action and sample(action.Anim, action.Time) or idlePose()
	if action and action.From and action.Time < BLEND_TIME then
		local a = TweenService:GetValue(action.Time / BLEND_TIME, SINE, OUT)
		pose = lerpPose(action.From, pose, a)
	end
	state.Last = pose

	-- итоговое положение кисти
	local idleMul = (action and 0.3 or 1) * cfg.Breathing
	local t = state.Clock
	local breathe = V(0, math.sin(t * 1.6) * 0.012 * idleMul, 0)
	local outer = pitchCF * CFrame.new(V(state.Sway.X * 0.22, -state.Sway.Y * 0.18, 0) + bob + breathe)
	local localRot = ANG(
		math.sin(t * 1.7) * 1.2 * idleMul + state.Sway.Y * 18,
		state.Sway.X * 22,
		math.sin(t * 1.1) * 1.4 * idleMul + state.Sway.X * 14 + math.sin(ph) * 2.5 * state.BobAmount
	)
	local hand = outer * pose.Hand
	hand = CFrame.new(hand.Position) * localRot * hand.Rotation
	local eq = TweenService:GetValue(state.Weight, QUART, OUT)
	if eq < 0.999 then
		hand = (outer * LOWERED):Lerp(hand, eq)
	end

	if state.Equipped and state.Knife and state.Grip then
		state.Grip.C0 = hand * GRIP_USER * pose.Grip
		updateKnife(state.Knife, pose)
	end

	local w = state.Weight * state.Weight * (3 - 2 * state.Weight)
	applyArm(rig.Arm, hand, w)
end

