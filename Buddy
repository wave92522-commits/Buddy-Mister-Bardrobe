local SINE, QUAD, BACK, LINEAR = Enum.EasingStyle.Sine, Enum.EasingStyle.Quad, Enum.EasingStyle.Back, Enum.EasingStyle.Linear
local QUART = Enum.EasingStyle.Quart
local IN, OUT, INOUT = Enum.EasingDirection.In, Enum.EasingDirection.Out, Enum.EasingDirection.InOut

local CF_FIELDS = { "Hand", "Grip" }
local NUM_FIELDS = { "A", "C", "Latch", "Shine", "Trail" }
local ANGLE_FIELDS = { A = true, C = true }

-- эталонная поза, под которую написаны анимации
local IDLE_BLADE = V(-0.55, 0.75, -0.35)
local IDLE_EDGE = V(-0.75, -0.5, 0.2)
local REF_HOLD = KF(0.8, 0.9, -1.45, IDLE_BLADE, IDLE_EDGE)
local BASE_HOLD_ROT = REF_HOLD.Rotation

local HOLD, LOWERED, RETARGET, GRIP_USER, DEFAULT_POSE
local ANIMS = {}

local function buildAnim(name, kind, list, events)
	local keys = {}
	local prev = DEFAULT_POSE
	for i, item in ipairs(list) do
		local data = item[2] or {}
		local key = { T = item[1], Ease = data.Ease or SINE, Dir = data.Dir or INOUT }
		local base = data.Reset and DEFAULT_POSE or prev
		for field in pairs(DEFAULT_POSE) do
			local value = data[field]
			if value ~= nil then
				if field == "Hand" then
					value = RETARGET * value
				end
				key[field] = value
			else
				key[field] = base[field]
			end
		end
		keys[i] = key
		prev = key
	end
	table.sort(events, function(a, b)
		return a[1] < b[1]
	end)
	return { Name = name, Kind = kind, Keys = keys, Length = keys[#keys].T, Events = events }
end

local function sample(anim, t)
	local keys = anim.Keys
	local a, b = keys[#keys], keys[#keys]
	for i = 1, #keys - 1 do
		if t <= keys[i + 1].T then
			a, b = keys[i], keys[i + 1]
			break
		end
	end
	local span = b.T - a.T
	local alpha = span > 0 and math.clamp((t - a.T) / span, 0, 1) or 1
	alpha = TweenService:GetValue(alpha, b.Ease, b.Dir)
	local pose = {}
	for _, f in ipairs(CF_FIELDS) do
		pose[f] = a[f]:Lerp(b[f], alpha)
	end
	for _, f in ipairs(NUM_FIELDS) do
		pose[f] = a[f] + (b[f] - a[f]) * alpha
	end
	return pose
end

local function idlePose()
	local pose = {}
	for k, v in pairs(DEFAULT_POSE) do
		pose[k] = v
	end
	return pose
end

local function lerpPose(a, b, t)
	local out = {}
	for _, f in ipairs(CF_FIELDS) do
		out[f] = a[f]:Lerp(b[f], t)
	end
	for _, f in ipairs(NUM_FIELDS) do
		local from = a[f]
		if ANGLE_FIELDS[f] then
			from = from - 360 * math.floor((from - b[f]) / 360 + 0.5) -- кратчайший путь
		end
		out[f] = from + (b[f] - from) * t
	end
	return out
end

