local ICON_FRAMES_BASE64 = {
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
}

local function base64Decode(data)
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local lookup = {}
	for i = 1, 64 do
		lookup[string.sub(alphabet, i, i)] = i - 1
	end
	data = string.gsub(data, "[^%w%+/=]", "")
	local out = {}
	for i = 1, #data, 4 do
		local c1, c2, c3, c4 = string.sub(data, i, i), string.sub(data, i + 1, i + 1), string.sub(data, i + 2, i + 2), string.sub(data, i + 3, i + 3)
		local n = (lookup[c1] or 0) * 262144 + (lookup[c2] or 0) * 4096 + (lookup[c3] or 0) * 64 + (lookup[c4] or 0)
		out[#out + 1] = string.char(math.floor(n / 65536) % 256)
		if c3 ~= "=" and c3 ~= "" then
			out[#out + 1] = string.char(math.floor(n / 256) % 256)
		end
		if c4 ~= "=" and c4 ~= "" then
			out[#out + 1] = string.char(n % 256)
		end
	end
	return table.concat(out)
end

local ICON_FRAMES = {}
local function resolveIcons()
	local icon = CONFIG.Icon
	if type(icon) == "number" and icon > 0 then
		ICON_FRAMES = { string.format("rbxthumb://type=Asset&id=%d&w=150&h=150", icon) }
	elseif type(icon) == "string" and icon ~= "" then
		ICON_FRAMES = { icon }
	end
	if CONFIG.AnimatedIcon and type(CONFIG.IconFrames) == "table" and #CONFIG.IconFrames > 0 then
		ICON_FRAMES = {}
		for _, id in ipairs(CONFIG.IconFrames) do
			if type(id) == "number" and id > 0 then
				table.insert(ICON_FRAMES, string.format("rbxthumb://type=Asset&id=%d&w=150&h=150", id))
			elseif type(id) == "string" and id ~= "" then
				table.insert(ICON_FRAMES, id)
			end
		end
	end
	if #ICON_FRAMES > 0 then
		return
	end
	-- встроенные кадры (executor с writefile + getcustomasset)
	pcall(function()
		local write = writefile
		local custom = getcustomasset or getsynasset
		if not (write and custom) then
			return
		end
		local count = CONFIG.AnimatedIcon and #ICON_FRAMES_BASE64 or 1
		for i = 1, count do
			local file = string.format("RiftBalisong_icon_%d.png", i)
			write(file, base64Decode(ICON_FRAMES_BASE64[i]))
			table.insert(ICON_FRAMES, custom(file))
		end
	end)
end
resolveIcons()

if #ICON_FRAMES > 1 then
	task.spawn(function()
		local i = 0
		while Session.Alive do
			i = i % #ICON_FRAMES + 1
			local tool = state.Tool
			if tool and tool.Parent then
				tool.TextureId = ICON_FRAMES[i]
			end
			task.wait(CONFIG.IconFrameTime)
		end
	end)
end

