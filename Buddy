local function unbindActions()
	pcall(function()
		ContextActionService:UnbindAction(ACTION_ALT)
	end)
	pcall(function()
		ContextActionService:UnbindAction(ACTION_INSPECT)
	end)
end

local function bindActions()
	ContextActionService:BindAction(ACTION_ALT, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			onSecondary()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	ContextActionService:BindAction(ACTION_INSPECT, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			onInspect()
		end
		return Enum.ContextActionResult.Sink
	end, true, CONFIG.InspectKey, Enum.KeyCode.ButtonY)
	pcall(function()
		ContextActionService:SetTitle(ACTION_ALT, "ПКМ")
		ContextActionService:SetTitle(ACTION_INSPECT, "F")
	end)
end

local function createTool()
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack", 10)
	if not backpack or not state.Rig then
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = CONFIG.ToolName
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "ЛКМ — удары · ПКМ — тяжёлая · F — осмотр"
	tool.TextureId = ICON_FRAMES[1] or ""

	local knife = buildKnife(tool)
	local grip = Instance.new("Motor6D")
	grip.Name = "KnifeGrip"
	grip.Part0 = state.Rig.Torso
	grip.Part1 = knife.Root
	grip.C0 = LOWERED * GRIP_BASE
	grip.Parent = knife.Root
	updateKnife(knife, DEFAULT_POSE)

	state.Tool, state.Knife, state.Grip = tool, knife, grip

	table.insert(state.CharConns, tool.Equipped:Connect(function()
		state.Equipped = true
		state.Weight = math.min(state.Weight, 0.05)
		state.Action = { Anim = ANIMS.Draw, Time = 0, NextEvent = 1 }
		state.FidgetTimer = 8 + math.random() * 6
		bindActions()
	end))
	table.insert(state.CharConns, tool.Unequipped:Connect(function()
		state.Equipped = false
		state.Action = nil
		if state.Knife then
			state.Knife.Trail.Enabled = false
		end
		unbindActions()
	end))
	table.insert(state.CharConns, tool.Activated:Connect(onPrimary))
	table.insert(state.CharConns, tool.AncestryChanged:Connect(function()
		if not tool:IsDescendantOf(game) and state.Tool == tool then
			state.Equipped = false
			state.Action = nil
			state.Tool, state.Knife, state.Grip = nil, nil, nil
			unbindActions()
		end
	end))
	tool.Parent = backpack
end

local function cleanupCharacter()
	for _, c in ipairs(state.CharConns) do
		c:Disconnect()
	end
	state.CharConns = {}
	unbindActions()
	if state.Tool then
		state.Tool:Destroy()
	end
	state.Tool, state.Knife, state.Grip, state.Rig = nil, nil, nil, nil
	state.Equipped, state.Action, state.Weight = false, nil, 0
end

local function onCharacter(character)
	cleanupCharacter()
	local rig = getRig(character)
	if not rig or not Session.Alive or LocalPlayer.Character ~= character then
		return
	end
	state.Rig = rig
	createTool()
	table.insert(state.CharConns, rig.Humanoid.Died:Connect(function()
		state.Equipped = false
		state.Action = nil
		unbindActions()
	end))
end

