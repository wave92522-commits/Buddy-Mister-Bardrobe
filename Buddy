local savedArmTransparency = {}
local function restoreArms()
	for part, value in pairs(savedArmTransparency) do
		if part.Parent then
			part.Transparency = value
		end
	end
	savedArmTransparency = {}
end

local function render()
	if CONFIG.ShowArmInFirstPerson and state.Weight > 0 and state.Rig then
		for _, p in ipairs(state.Rig.ArmParts) do
			p.LocalTransparencyModifier = 0
			if CONFIG.ForceArmsVisible and p.Transparency > 0 and p.Transparency < 1.01 then
				if savedArmTransparency[p] == nil then
					savedArmTransparency[p] = p.Transparency
				end
				p.Transparency = 0
			end
		end
	elseif next(savedArmTransparency) then
		restoreArms()
	end
	if state.Equipped and state.Knife then
		for _, p in ipairs(state.Knife.Parts) do
			p.LocalTransparencyModifier = 0
		end
	end
	if Gui.Panel and Gui.Panel.Visible then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end

