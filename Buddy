	end
	if name == "Glint" then
		knife.Sparkles:Emit(10)
		return
	end
	local entry = knife.Sounds[name]
	if entry then
		entry.Sound.PlaybackSpeed = entry.Speed * (0.93 + math.random() * 0.14)
		entry.Sound.TimePosition = 0
		entry.Sound:Play()
	end
end

local function startAction(anim, interrupt)
	state.Action = { Anim = anim, Time = 0, NextEvent = 1, From = (interrupt and state.Last) or nil }
	state.FidgetTimer = 8 + math.random() * 6
	return true
end

-- можно ли начать новую атаку прямо сейчас (комбо)
local function canAttack()
	if not state.Equipped or state.Weight < 0.85 then
		return false
	end
	local a = state.Action
	if not a then
		return true, false
	end
	local kind = a.Anim.Kind
	if kind == "inspect" or kind == "fidget" then
		return true, true
	end
	if (kind == "swing" or kind == "heavy") and a.Time >= a.Anim.Length * 0.55 then
		return true, true
	end
	return false
end

local function onPrimary()
	local ok, interrupt = canAttack()
	if not ok then
		return
	end
	-- если прошлый удар закончился давно — комбо начинается сначала
	if not state.Action and state.Clock - (state.LastSwingAt or -10) > 1.2 then
		state.LmbIndex = 0
	end
	state.LmbIndex = state.LmbIndex % #LMB_ANIMS + 1
	state.LastSwingAt = state.Clock
	startAction(LMB_ANIMS[state.LmbIndex], interrupt)
end

local function onSecondary()
	local ok, interrupt = canAttack()
	if not ok then
		return
	end
	state.RmbIndex = state.RmbIndex % #RMB_ANIMS + 1
	startAction(RMB_ANIMS[state.RmbIndex], interrupt)
end

local function onInspect()
	if not state.Equipped or state.Weight < 0.85 then
		return
	end
	local a = state.Action
	if a and a.Anim.Kind ~= "fidget" then
		return
	end
	startAction(ANIMS.Inspect, a ~= nil)
end

