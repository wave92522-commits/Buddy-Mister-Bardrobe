-- РИГ ИГРОКА + IK (плечо, локоть, кисть)
------------------------------------------------------------------------
local function getRig(character)
	local hum = character:WaitForChild("Humanoid", 10)
	local rootPart = character:WaitForChild("HumanoidRootPart", 10)
	if not (hum and rootPart) then
		return nil
	end
	local rig = { Humanoid = hum, RootPart = rootPart, Head = character:FindFirstChild("Head"), ArmParts = {} }
	if hum.RigType == Enum.HumanoidRigType.R15 then
		rig.Torso = character:WaitForChild("UpperTorso", 10)
		local ua = character:WaitForChild("RightUpperArm", 10)
		local la = character:WaitForChild("RightLowerArm", 10)
		local hand = character:WaitForChild("RightHand", 10)
		if not (rig.Torso and ua and la and hand) then
			return nil
		end
		local sh = ua:WaitForChild("RightShoulder", 10)
		local el = la:WaitForChild("RightElbow", 10)
		local wr = hand:WaitForChild("RightWrist", 10)
		if not (sh and el and wr) then
			return nil
		end
		rig.Arm = { R15 = true, Shoulder = sh, Elbow = el, Wrist = wr }
		rig.ArmParts = { ua, la, hand }
	else
		rig.Torso = character:WaitForChild("Torso", 10)
		local arm = character:WaitForChild("Right Arm", 10)
		local sh = rig.Torso and rig.Torso:WaitForChild("Right Shoulder", 10)
		if not (arm and sh) then
			return nil
		end
		rig.Arm = { R15 = false, Shoulder = sh, ArmPart = arm }
		rig.ArmParts = { arm }
	end
	return rig
end

local function frameFrom(down, pole)
	local y = -down
	local z = perp(pole, y)
	if z.Magnitude < 1e-4 then
		z = perp(Vector3.zAxis, y)
	end
	if z.Magnitude < 1e-4 then
		z = perp(Vector3.xAxis, y)
	end
	z = z.Unit
	return CFrame.fromMatrix(Vector3.zero, y:Cross(z), y, z)
end

local function boneRotation(boneLocal, dir, pole)
	local fl = frameFrom(safeUnit(boneLocal, V(0, -1, 0)), Vector3.zAxis)
	local fw = frameFrom(dir, pole)
	return fw * fl:Inverse()
end

-- рука тянется к запястью, локоть — по линии предплечья, кисть повёрнута как надо
local function solveHand(limb, handCF)
	local sh, el, wr = limb.Shoulder, limb.Elbow, limb.Wrist
	local s0 = sh.C0.Position
	local wrist = handCF * wr.C1.Position
	local boneU = el.C0.Position - sh.C1.Position
	local boneL = wr.C0.Position - el.C1.Position
	local a, b = math.max(boneU.Magnitude, 0.05), math.max(boneL.Magnitude, 0.05)

	local toT = wrist - s0
	local u = safeUnit(toT, V(0, -1, 0))
	local dist = math.clamp(toT.Magnitude, math.abs(a - b) + 1e-3, a + b - 1e-3)
	local cosA = math.clamp((a * a + dist * dist - b * b) / (2 * a * dist), -1, 1)
	local sinA = math.sqrt(1 - cosA * cosA)
	-- локоть стремится продолжить линию кисти, но с естественным уклоном вниз-наружу
	-- локоть всегда вниз-наружу (иначе предплечье поднимается и закрывает нож);
	-- линия кисти учитывается, только если она сама идёт вниз
	local idealElbow = wrist + handCF.UpVector * b
	local pole = V(0.6, -1, 0.3)
	if idealElbow.Y < wrist.Y then
		pole = pole + safeUnit(idealElbow - s0, V(0, -1, 0)) * 0.35
	end
	local w = safeUnit(perp(pole, u), safeUnit(perp(V(0.5, -1, 0.3), u), Vector3.zAxis))

	local elbowPos = s0 + (u * cosA + w * sinA) * a
	local t = s0 + u * dist
	local d1 = safeUnit(elbowPos - s0, u)
	local zU = safeUnit(-perp(t - elbowPos, d1), w)

	local upperCF = CFrame.new(s0) * boneRotation(boneU, d1, zU) * CFrame.new(-sh.C1.Position)
	local e = upperCF * el.C0.Position
	local d2 = safeUnit(t - e, d1)
	local lowerCF = CFrame.new(e) * boneRotation(boneL, d2, zU) * CFrame.new(-el.C1.Position)

	local trS = sh.C0:Inverse() * upperCF * sh.C1
	local trE = el.C0:Inverse() * (upperCF:Inverse() * lowerCF) * el.C1
	local trW = (lowerCF * wr.C0).Rotation:Inverse() * (handCF * wr.C1).Rotation
	return trS, trE, trW
end

local function solveR6(limb, target)
	local sh = limb.Shoulder
	local s0 = sh.C0.Position
	local handLocal = V(0, -(limb.ArmPart.Size.Y / 2 - 0.2), 0)
	local bone = handLocal - sh.C1.Position
	local dir = safeUnit(target - s0, V(0, -1, 0))
	local armCF = CFrame.new(s0) * boneRotation(bone, dir, V(0, -1, 1)) * CFrame.new(-sh.C1.Position)
	return sh.C0:Inverse() * armCF * sh.C1
end

local function blendTransform(m, target, w)
	if w >= 0.999 then
		m.Transform = target
	else
		m.Transform = m.Transform:Lerp(target, w)
	end
end

local function applyArm(limb, handCF, w)
	if not limb.Shoulder.Parent then
		return
	end
	if limb.R15 then
		if not (limb.Elbow.Parent and limb.Wrist.Parent) then
			return
		end
		local trS, trE, trW = solveHand(limb, handCF)
		blendTransform(limb.Shoulder, trS, w)
		blendTransform(limb.Elbow, trE, w)
		blendTransform(limb.Wrist, trW, w)
	else
		blendTransform(limb.Shoulder, solveR6(limb, handCF.Position), w)
	end
end

