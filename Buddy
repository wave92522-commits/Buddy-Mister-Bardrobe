function Session.Destroy()
	Session.Alive = false
	for _, c in ipairs(Session.Connections) do
		c:Disconnect()
	end
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_NAME)
	end)
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_NAME .. "Late")
	end)
	pcall(restoreArms)
	if Gui.Screen then
		Gui.Screen:Destroy()
	end
	local rig = state.Rig
	cleanupCharacter()
	if rig and rig.Arm then
		pcall(function()
			rig.Arm.Shoulder.Transform = CFrame.new()
			if rig.Arm.R15 then
				rig.Arm.Elbow.Transform = CFrame.new()
				rig.Arm.Wrist.Transform = CFrame.new()
			end
		end)
	end
end
