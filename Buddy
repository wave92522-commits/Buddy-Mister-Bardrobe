local PIN_D = 0.055 -- половина расстояния между пинами
local LATCH_Y = -0.99

local function buildKnife(parent)
	local model = Instance.new("Model")
	model.Name = "RiftBalisong"
	local rig = { Model = model, Parts = {}, Pivots = {}, Glints = {}, Glow = {}, Sounds = {} }

	local function newPart(class, name, size, color, material)
		local p = Instance.new(class)
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		table.insert(rig.Parts, p)
		return p
	end
	local function pivot(name)
		local p = newPart("Part", "Pivot_" .. name, V(0.05, 0.05, 0.05), Color3.new(), Enum.Material.SmoothPlastic)
		p.Transparency = 1
		rig.Pivots[name] = p
		return p
	end
	local function motor(p0, p1)
		local m = Instance.new("Motor6D")
		m.Part0 = p0
		m.Part1 = p1
		m.Parent = p1
		return m
	end

	local safe, blade, bite, latch = pivot("safe"), pivot("blade"), pivot("bite"), pivot("latch")
	rig.Root = safe
	rig.BladeMotor = motor(safe, blade)
	rig.BiteMotor = motor(blade, bite)
	rig.LatchMotor = motor(bite, latch)

	local WEDGE_R = CFrame.fromMatrix(Vector3.zero, V(0, 0, 1), V(0, 1, 0), V(-1, 0, 0))
	local WEDGE_L = CFrame.fromMatrix(Vector3.zero, V(0, 0, -1), V(0, 1, 0), V(1, 0, 0))

	for _, spec in ipairs(KNIFE) do
		local name, shape, pos, size = spec[1], spec[2], spec[3], spec[4]
		local color = CONFIG.Colors[spec[5]] or Color3.new(1, 1, 1)
		local rot, mat, group, role = spec[6], spec[7], spec[8], spec[9]
		local material = mat == "neon" and Enum.Material.Neon or Enum.Material.SmoothPlastic
		local cf = CFrame.new(V(pos[1], pos[2], pos[3]) * S) * ANG(rot[1], rot[2], rot[3])
		local part
		if shape == "cylZ" then
			part = newPart("Part", name, V(size[3], size[1], size[2]) * S, color, material)
			part.Shape = Enum.PartType.Cylinder
			part.Size = V(size[3], size[1], size[2]) * S
			cf = cf * CFrame.Angles(0, PI / 2, 0)
		elseif shape == "wedgeR" or shape == "wedgeL" then
			part = newPart("WedgePart", name, V(size[3], size[2], size[1]) * S, color, material)
			cf = CFrame.new(cf.Position) * (shape == "wedgeR" and WEDGE_R or WEDGE_L)
		else
			part = newPart("Part", name, V(size[1], size[2], size[3]) * S, color, material)
		end
		if mat == "blade" then
			part.Reflectance = 0.35
		elseif mat == "metal" then
			part.Reflectance = 0.2
		end
		local w = Instance.new("Weld")
		w.Part0 = rig.Pivots[group]
		w.Part1 = part
		w.C0 = cf
		w.Parent = part
		if role == "glint" then
			part.Transparency = 1
			table.insert(rig.Glints, { Part = part, Weld = w })
		end
		if name == "Rift" or name == "Rift branch" or name == "Edge glow" or name == "Tip glow" then
			table.insert(rig.Glow, part)
		end
		if name == "Blade" then
			rig.BladeBody = part
		end
	end

	-- шлейф за клинком
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTip"
	a0.Position = V(0, 0.98, 0) * S
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBase"
	a1.Position = V(0, 0.3, 0) * S
	a1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.17
	trail.MinLength = 0.01
	trail.LightEmission = 0.75
	trail.LightInfluence = 0
	trail.FaceCamera = false
	trail.Color = ColorSequence.new(CONFIG.Colors.White, CONFIG.Colors.Accent)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.5, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new(1, 0.4)
	trail.Enabled = false
	trail.Parent = blade
	rig.Trail = trail

	-- искры на кончике (блик при осмотре)
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(CONFIG.Colors.Accent:Lerp(CONFIG.Colors.White, 0.5))
	sparkles.LightEmission = 1
	sparkles.Lifetime = NumberRange.new(0.25, 0.5)
	sparkles.Speed = NumberRange.new(0.4, 1.2)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Rate = 0
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.07), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Parent = a0
	rig.Sparkles = sparkles

	-- мягкий свет от клинка
	if CONFIG.BladeGlow then
		local light = Instance.new("PointLight")
		light.Color = CONFIG.Colors.Accent
		light.Range = 5
		light.Brightness = 0.7
		light.Shadows = false
		light.Parent = rig.BladeBody or blade
		rig.Light = light
	end
	-- искры, слетающие с разлома
	if CONFIG.Sparks and rig.BladeBody then
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparks.Color = ColorSequence.new(CONFIG.Colors.Accent, CONFIG.Colors.Accent2)
		sparks.LightEmission = 1
		sparks.LightInfluence = 0
		sparks.Lifetime = NumberRange.new(0.35, 0.7)
		sparks.Speed = NumberRange.new(0.15, 0.5)
		sparks.SpreadAngle = Vector2.new(180, 180)
		sparks.Acceleration = V(0, 0.6, 0)
		sparks.Rate = 5
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.045), NumberSequenceKeypoint.new(1, 0) })
		sparks.Transparency = NumberSequence.new(0.1, 1)
		sparks.Parent = rig.BladeBody
	end

	for name, cfg in pairs(CONFIG.Sounds) do
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = cfg.Id
		s.Volume = cfg.Volume
		s.PlaybackSpeed = cfg.Speed
		s.RollOffMaxDistance = 40
		s.Parent = safe
		rig.Sounds[name] = { Sound = s, Speed = cfg.Speed }
	end

	model.Parent = parent
	return rig
end

------------------------------------------------------------------------
-- ХВАТ
-- Кисть R15: пальцы -Y, большой палец -Z, ладонь -X. Рукоять проходит
-- через кулак вдоль оси большого пальца, клинок выходит над ним, кромка
-- смотрит в сторону костяшек.
------------------------------------------------------------------------
local RK = CFrame.fromMatrix(Vector3.zero, V(0, -1, 0), V(0, 0, -1)) -- оси ножа в осях кисти
-- Кисть R15 — плита 1×1 стад, поэтому пин вынесен за её край: клинок
-- начинается там, где кисть заканчивается, и не прячется за ней.
local GRIP_BASE = CFrame.new(-0.04, 0, 0) * RK * CFrame.new(-PIN_D * S, 0.55, 0)
-- трюки: нож держат кончики пальцев у левого края кисти — крутится сбоку от неё
local GRIP_PIN = CFrame.new(0, -0.58, -0.25) * RK

-- нож крутится вокруг пина на кончиках пальцев; lift — подброс вдоль большого пальца
local function GS(deg, lift)
	return CFrame.new(0, 0, -(lift or 0)) * GRIP_PIN * CFrame.Angles(0, 0, rad(deg))
end
-- нож прокручивается в кулаке вокруг своей оси
local function GROLL(deg)
	return GRIP_BASE * CFrame.Angles(0, rad(deg), 0)
end

-- Кисть в торсе по тому, куда смотрит клинок и кромка (оси ножа):
-- pos — центр кисти, blade — направление клинка, edge — куда смотрит кромка
local function KF(x, y, z, blade, edge)
	local Y = blade.Unit
	local X = safeUnit(perp(edge, Y), safeUnit(perp(FWD, Y), RIGHT))
	local Z = X:Cross(Y)
	return CFrame.new(x, y, z) * CFrame.fromMatrix(Vector3.zero, X, Y, Z) * RK:Inverse()
end

